# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campussphere

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_campussphere_2026_dev
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Campus Email Policy
ALLOWED_EMAIL_DOMAIN=campussphere.edu
REQUIRE_CAMPUS_EMAIL=false

# Optional Cloudinary (Leave empty for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP Settings (Leave empty to use console logger)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@campussphere.edu
